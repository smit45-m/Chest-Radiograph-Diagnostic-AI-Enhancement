# CXR-Diagnostic Pro v4.0 Environment Configuration
# Copy to .env and set your API keys.

# Primary Multimodal AI Engine: Google Gemini Decision 1 + Interactions API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-4-hydrogen
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_DECISION_ENABLED=true
GEMINI_DECISION_WEIGHT=0.30

# Fast Cloud LLM Fallback (Optional)
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
OPENAI_API_KEY=

# Model & Device Configuration
CXR_ENSEMBLE_MODE=full
CXR_CHECKPOINT=checkpoints/best.pt
CXR_DEVICE=cuda
